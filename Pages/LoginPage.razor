@page "/login"
@using SalaDoFuturo.wwwroot.Configurations
@inject NavigationManager NavManager

<div class="sf-container">
    <div class="sf-header">
        <div class="logo">
            <img src="Images/icone.jpeg" alt="Logo Sala do Futuro" class="logo-img" />
        </div>
        <h2 class="title">Estudante</h2>
        <p class="subtitle">Preencha seus dados abaixo para acessar o sistema.</p>
    </div>

    <div class="login-form">
        <div class="form-group">
            <label>RA</label>
            <!-- Data binding bidirecional com a propriedade Ra -->
            <input type="text" placeholder="Digite seu RA" @bind="Ra" @bind:event="oninput" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Digito RA</label>
                <input type="text" placeholder="0" />
            </div>
            <div class="form-group">
                <label>UF</label>
                <select><option>SP</option></select>
            </div>
        </div>
        <a href="#" class="link">Esqueceu o RA?</a>

        <div class="form-group">
            <label>Senha</label>
            <div class="password-input">
                <input type="password" placeholder="Digite sua senha" />
                <span class="eye-icon">👁️</span>
            </div>
        </div>
        <p class="help-text">Esqueceu a senha? <strong>Acesse aqui</strong>, clique em esqueci a senha e siga as instruções.</p>
    </div>

    <!-- Chama o método C# que consome o RA capturado -->
    <button class="btn-primary" @onclick="ProcessarAcesso">Acessar</button>
    <button class="btn-secondary" @onclick='() => NavManager.NavigateTo("/selection")'>Voltar</button>

    <div class="footer">
        <a href="#">Preciso de ajuda</a>
    </div>
</div>

<style>
    .sf-container { max-width: 400px; margin: 0 auto; padding: 20px; font-family: sans-serif; display: flex; flex-direction: column; gap: 15px; }
    .sf-header { text-align: center; }
    .logo { display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
    .logo-img { max-width: 180px; height: auto; object-fit: contain; }
    .login-form { display: flex; flex-direction: column; gap: 10px; }
    .form-group { display: flex; flex-direction: column; text-align: left; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    input, select { padding: 12px; border: 1px solid #ccc; border-radius: 8px; }
    .password-input { position: relative; }
    .eye-icon { position: absolute; right: 10px; top: 12px; cursor: pointer; }
    .btn-primary { background: #0056b3; color: white; border: none; padding: 15px; border-radius: 8px; font-weight: bold; cursor: pointer; }
    .btn-secondary { background: transparent; border: 1px solid #0056b3; color: #0056b3; padding: 15px; border-radius: 8px; font-weight: bold; cursor: pointer; }
    .link { font-size: 12px; color: #007bff; text-decoration: none; }
    .help-text { font-size: 12px; color: #666; }
</style>

@code {
    // Propriedade para armazenar o valor digitado no input do RA
    public string Ra { get; set; } = string.Empty;

    // Método disparado ao clicar no botão 'Acessar'
    private void ProcessarAcesso()
    {
        if (!string.IsNullOrWhiteSpace(Ra))
        {
            // O valor do RA capturado está acessível em 'Ra'
            Console.WriteLine($"RA informado pelo usuário: {Ra}");
            User.Name = Ra;
            // Redireciona para a home
            NavManager.NavigateTo("/");
        }
    }
}