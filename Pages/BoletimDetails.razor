@page "/BoletimDetails"
@using SalaDoFuturo.wwwroot.Configurations

<PageTitle>Boletim Escolar - Governo do Estado de São Paulo</PageTitle>

<div class="boletim-container">
    <div class="header">
        <h1>GOVERNO DO ESTADO DE SÃO PAULO</h1>
        <h2>SECRETARIA DE ESTADO DA EDUCAÇÃO</h2>
        <h3>Boletim Escolar</h3>
    </div>

    @if (boletimData != null)
    {
        <!-- Informações do Aluno / Cabeçalho -->
        <div class="info-section">
            <div class="info-row">
                <div><strong>Nome do Aluno:</strong> @User.Name</div>
                <div><strong>RA:</strong> @boletimData.Aluno.RA</div>
                <div><strong>Ano Letivo:</strong> 2026</div>
            </div>
            <div class="info-row">
                <div><strong>Diretoria:</strong> @boletimData.Aluno.Diretoria</div>
                <div><strong>Escola:</strong> @boletimData.Aluno.Escola</div>
            </div>
            <div class="info-row">
                <div><strong>Tipo de Ensino:</strong> @boletimData.Aluno.TipoEnsino</div>
                <div><strong>Turma:</strong> @boletimData.Aluno.Turma</div>
            </div>
        </div>

        <!-- Tabela Novo Ensino Médio -->
        <table class="boletim-table">
            <thead>
                <tr>
                    <th rowspan="2" class="col-disciplina">Disciplina</th>
                    <th colspan="4">1º Bimestre</th>
                    <th colspan="4">2º Bimestre</th>
                    <th colspan="4">3º Bimestre</th>
                    <th colspan="4">4º Bimestre</th>
                    <th colspan="4">CF</th>
                </tr>
                <tr>
                    @for (int i = 0; i < 5; i++)
                    {
                        <th>N</th><th>F</th><th>%Freq</th><th>AC</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var disc in boletimData.DisciplinasNovoEnsinoMedio)
                {
                    <tr>
                        <td class="subject">@disc.Nome</td>
                        <!-- 1º Bimestre -->
                        <td>@disc.Bimestre1.Nota</td>
                        <td>@disc.Bimestre1.Faltas</td>
                        <td>@disc.Bimestre1.FreqFormatada</td>
                        <td>@disc.Bimestre1.ACFormatado</td>
                        <!-- 2º Bimestre -->
                        <td>@disc.Bimestre2.Nota</td>
                        <td>@disc.Bimestre2.Faltas</td>
                        <td>@disc.Bimestre2.FreqFormatada</td>
                        <td>@disc.Bimestre2.ACFormatado</td>
                        <!-- 3º Bimestre -->
                        <td>@disc.Bimestre3.Nota</td>
                        <td>@disc.Bimestre3.Faltas</td>
                        <td>@disc.Bimestre3.FreqFormatada</td>
                        <td>@disc.Bimestre3.ACFormatado</td>
                        <!-- 4º Bimestre -->
                        <td>@disc.Bimestre4.Nota</td>
                        <td>@disc.Bimestre4.Faltas</td>
                        <td>@disc.Bimestre4.FreqFormatada</td>
                        <td>@disc.Bimestre4.ACFormatado</td>
                        <!-- CF -->
                        <td>@disc.CF.Nota</td>
                        <td>@disc.CF.Faltas</td>
                        <td>@disc.CF.FreqFormatada</td>
                        <td>@disc.CF.ACFormatado</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="resultado-final">
            <strong>Resultado Final:</strong> @(string.IsNullOrEmpty(boletimData.ResultadoFinalNovoEnsinoMedio) ? "-" : boletimData.ResultadoFinalNovoEnsinoMedio)
        </div>

        <!-- Informações Itinerário Formativo -->
        <div class="info-section">
            <div class="info-row">
                <div><strong>Diretoria:</strong> @boletimData.Aluno.Diretoria</div>
                <div><strong>Escola:</strong> @boletimData.Aluno.Escola</div>
            </div>
            <div class="info-row">
                <div><strong>Tipo de Ensino:</strong> @boletimData.Itinerario.TipoEnsino</div>
                <div><strong>Turma:</strong> @boletimData.Itinerario.Turma</div>
            </div>
        </div>

        <!-- Tabela Itinerário Formativo -->
        <table class="boletim-table">
            <thead>
                <tr>
                    <th rowspan="2" class="col-disciplina">Disciplina</th>
                    <th colspan="4">1º Bimestre</th>
                    <th colspan="4">2º Bimestre</th>
                    <th colspan="4">3º Bimestre</th>
                    <th colspan="4">4º Bimestre</th>
                    <th colspan="4">CF</th>
                </tr>
                <tr>
                    @for (int i = 0; i < 5; i++)
                    {
                        <th>N</th><th>F</th><th>%Freq</th><th>AC</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var disc in boletimData.DisciplinasItinerario)
                {
                    <tr>
                        <td class="subject">@disc.Nome</td>
                        <!-- 1º Bimestre -->
                        <td>@disc.Bimestre1.Nota</td>
                        <td>@disc.Bimestre1.Faltas</td>
                        <td>@disc.Bimestre1.FreqFormatada</td>
                        <td>@disc.Bimestre1.ACFormatado</td>
                        <!-- 2º Bimestre -->
                        <td>@disc.Bimestre2.Nota</td>
                        <td>@disc.Bimestre2.Faltas</td>
                        <td>@disc.Bimestre2.FreqFormatada</td>
                        <td>@disc.Bimestre2.ACFormatado</td>
                        <!-- 3º Bimestre -->
                        <td>@disc.Bimestre3.Nota</td>
                        <td>@disc.Bimestre3.Faltas</td>
                        <td>@disc.Bimestre3.FreqFormatada</td>
                        <td>@disc.Bimestre3.ACFormatado</td>
                        <!-- 4º Bimestre -->
                        <td>@disc.Bimestre4.Nota</td>
                        <td>@disc.Bimestre4.Faltas</td>
                        <td>@disc.Bimestre4.FreqFormatada</td>
                        <td>@disc.Bimestre4.ACFormatado</td>
                        <!-- CF -->
                        <td>@disc.CF.Nota</td>
                        <td>@disc.CF.Faltas</td>
                        <td>@disc.CF.FreqFormatada</td>
                        <td>@disc.CF.ACFormatado</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="resultado-final">
            <strong>Resultado Final:</strong> @(string.IsNullOrEmpty(boletimData.ResultadoFinalItinerario) ? "-" : boletimData.ResultadoFinalItinerario)
        </div>

        <div class="siglas">
            <strong>Siglas:</strong><br />
            <strong>CF</strong> – Conselho Final (Quinto Conceito) &nbsp;|&nbsp;
            <strong>N</strong> - Notas &nbsp;|&nbsp;
            <strong>F</strong> - Faltas &nbsp;|&nbsp;
            <strong>AC</strong> - Ausências Compensadas
        </div>
    }
</div>

